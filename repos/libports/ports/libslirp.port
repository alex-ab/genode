LICENSE   := BSD-3-Clause
VERSION   := 4.9.3
DOWNLOADS := libslirp.archive

URL(libslirp) := https://gitlab.freedesktop.org/slirp/libslirp/-/archive/v$(VERSION)/libslirp-v$(VERSION).tar.gz
SHA(libslirp) := ee698ca4ce05217ca7d520c7f0b1b1228fd7d32922dd32d1051c347152588417
DIR(libslirp) := src/lib/libslirp

DIRS := include/slirp
DIR_CONTENT(include/slirp) := $(addprefix src/lib/libslirp/src/,libslirp.h)
