LICENSE   := GPLv2
VERSION   := git
DOWNLOADS := novae.git

# upstream release 25.35 + extensions required by Genode -> r25.35 branch
URL(novae) := https://github.com/alex-ab/NOVA.git
REV(novae) := e9e0e3603aeaaf44bb84bad832e04d5897a8da30
DIR(novae) := src/kernel/novae

PATCHES   := $(sort $(wildcard $(REP_DIR)/patches/*.patch))
PATCH_OPT := -p1 -d ${DIR(novae)}
