config

+ parent-provides
  + service CPU
  + service LOG
  + service PD
  + service ROM
  + service Timer
  + service Report
  + service Block

+ default-route
  + any-service
    + child part_block
    + parent

+ default | ram: 5M | caps: 100

+ start part_block | ram: 10M
  + provides | + service Block
  + route
    + any-service
      + parent
      + any-child
  + config | ignore_mbr: yes
    + report | partitions: yes
    + default-policy | partition: 0

+ start tester
  + binary block_tester
  + exit | propagate: yes
  + config | verbose: no | log: yes | stop_on_error: no
    + tests
      + sequential | length: 1M | size: 1K | io_buffer: 128K | batch: 4

-
