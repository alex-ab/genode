config

+ parent-provides
  + service CPU
  + service LOG
  + service PD
  + service ROM
  + service Timer
  + service Report
  + service Block

+ default-route
  + any-service
    + child part_block
    + parent

+ default | ram: 5M | caps: 100

+ start part_block | ram: 10M
  + provides | + service Block
  + route
    + any-service
      + parent
      + any-child
  + config
    + report | partitions: yes
    + policy | label_prefix: tester-1 | partition: 1
    + policy | label_prefix: tester-2 | partition: 2

+ start tester-1
  + binary block_tester
  + config | verbose: no | log: yes | stop_on_error: no
    + tests
      + sequential | length: 32K | size: 1K | io_buffer: 128K | batch: 4

+ start tester-2
  + binary block_tester
  + exit | propagate: yes
  + config | verbose: no | log: yes | stop_on_error: no
    + tests
      + sequential | length: 256K | size: 1K | io_buffer: 128K | batch: 2

-
