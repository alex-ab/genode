-        /*
-         * Done.
-         */
-        rc = pThisCC->Lun0.pNvramDrv->pfnVarStoreSeqEnd(pThisCC->Lun0.pNvramDrv, rc);
-    }
-    else
-        LogRel(("EFI: pfnVarStoreBegin failed: %Rrc\n", rc));
-    return rc;
