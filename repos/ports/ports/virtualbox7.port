LICENSE         := GPLv3
VERSION         := 7.2.14
DOWNLOADS       := virtualbox.archive virtualbox_sdk.archive

VIRTUALBOX_TBZ2    := VirtualBox-$(VERSION).tar.bz2
VIRTUALBOX_SDK_ZIP := VirtualBoxSDK-$(VERSION)-174565.zip

URL(virtualbox) := http://download.virtualbox.org/virtualbox/$(VERSION)/$(VIRTUALBOX_TBZ2)
DIR(virtualbox) := src/virtualbox7
SHA(virtualbox) := 384f293184c52fd51bc941c17d753b4019446f53a6b07c828adfb3e61fe0a500

URL(virtualbox_sdk) := http://download.virtualbox.org/virtualbox/$(VERSION)/$(VIRTUALBOX_SDK_ZIP)
DIR(virtualbox_sdk) := src/virtualbox7_sdk
SHA(virtualbox_sdk) := 7f388e22957f126535df297a3a6f258b293a39b73548485ba3257141175a3189

PATCHES_DIR := src/virtualbox7/patches
PATCHES     := $(addprefix $(PATCHES_DIR)/, $(shell cat $(REP_DIR)/$(PATCHES_DIR)/series))

$(call check_tool,xsltproc)
$(call check_tool,yasm)
$(call check_tool,iasl)

VBOX_MAIN_GLUE := AutoLock EventQueue string xpcom/helpers com ErrorInfo
VBOX_MAIN_GLUE += NativeEventQueue GetVBoxUserHomeDirectory VBoxLogRelCreate

VBOX_MAIN_ALL := AuthLibrary AutoCaller AudioUtils DisplayResampleImage DisplayUtils
VBOX_MAIN_ALL += PCIDeviceAttachmentImpl ProgressImpl SharedFolderImpl
VBOX_MAIN_ALL += ThreadTask VirtualBoxBase GlobalStatusConversion
VBOX_MAIN_ALL += EventImpl Global HashedPw SecretKeyStore CryptoUtils
VBOX_MAIN_ALL += ConsoleSharedFolderImpl NvramStoreImpl VirtualBoxErrorInfoImpl
VBOX_MAIN_ALL += RecordingUtils

VBOX_MAIN_CERT := MicCorUEFCA2011_2011-06-27 microsoft_option_rom_uefi_ca_2023
VBOX_MAIN_CERT += MicWinProPCA2011_2011-10-19 windows_uefi_ca_2023
VBOX_MAIN_CERT += MicCorKEKCA2011_2011-06-24 microsoft_corporation_kek_2k_ca_2023
VBOX_MAIN_CERT += microsoft_uefi_ca_2023 OrclUefiDefPk2021_2021-09-29

VBOX_MAIN_CLI := AdditionsFacilityImpl BusAssignmentManager
VBOX_MAIN_CLI += ConsoleImplConfigCommon ConsoleImplConfigX86
VBOX_MAIN_CLI += ConsoleImpl ConsoleVRDPServer
VBOX_MAIN_CLI += DisplayImpl DisplayImplLegacy DisplaySourceBitmapImpl
