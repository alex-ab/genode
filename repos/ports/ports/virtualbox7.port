VBOX_MAIN_SRV += PlatformX86Impl RecordingScreenSettingsImpl RecordingSettingsImpl
VBOX_MAIN_SRV += StorageControllerImpl VirtualBoxImpl SystemPropertiesImpl
VBOX_MAIN_SRV += UefiVariableStoreImpl
