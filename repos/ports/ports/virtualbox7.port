VBOX_MAIN_INC += ProgressImpl ProgressProxyImpl QMTranslator RecordingScreenSettingsImpl
VBOX_MAIN_INC += RecordingSettingsImpl RecordingContext RecordingUtils
VBOX_MAIN_INC += RemoteUSBBackend RemoteUSBDeviceImpl SecretKeyStore
