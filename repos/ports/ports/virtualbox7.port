VBOX_MAIN_CLI += GuestDnDTargetImpl

VBOX_MAIN_SRV := AudioAdapterImpl AudioSettingsImpl BandwidthControlImpl
VBOX_MAIN_SRV += BandwidthGroupImpl ClientToken ClientWatcher CPUProfileImpl
VBOX_MAIN_SRV += DHCPConfigImpl
VBOX_MAIN_SRV += DHCPServerImpl Matching DataStreamImpl GraphicsAdapterImpl
VBOX_MAIN_SRV += GuestOSTypeImpl GuestDebugControlImpl
VBOX_MAIN_SRV += HostUSBDeviceImpl HostDnsService HostImpl
VBOX_MAIN_SRV += HostNetworkInterfaceImpl MediumIOImpl HostPower
