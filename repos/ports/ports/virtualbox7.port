VBOX_MAIN_SRV += MediumImpl MediumAttachmentImpl MediumFormatImpl MediumLock
VBOX_MAIN_SRV += ParallelPortImpl NATEngineImpl NATNetworkImpl
VBOX_MAIN_SRV += NetworkAdapterImpl SnapshotImpl NetworkServiceRunner
