-->
		<service name="File_system" label="shared">
			<child name="shared_fs"/>
		</service>
		<service name="Gui">
			<child name="wm"/>
		</service>
		<service name="Nic">
			<child name="nic_router"/>
		</service>
		<service name="ROM" label="capslock">
			<parent label="capslock"/>
