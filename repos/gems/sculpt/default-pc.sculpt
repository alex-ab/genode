# configuration decisions
drivers: pc
system:  pc
gpu:     intel
manager: use_ram_fs
ram_fs:  depot

# supplemental depot content added to the system image
import: pkg/sculpt_drivers-pc pkg/acpica

# selection of launcher-menu entries
launcher: vm_fs shared_fs
# download_debug_info
launcher: black_hole trace_logger
launcher: audio mixer system_clock acpi_support recall_fs
# touchpad

# selection of accepted depot-package providers
depot: genodelabs alex-ab chelmuth cnuke cproc jschlatow nfeske skalk ssumpf

# preconfigured example scenarios
presets: empty nano3d window_manager
# falkon_web_browser goa_testbed

build: app/sculpt_manager driver/framebuffer/intel/pc lib/ld driver/gpu core kernel
