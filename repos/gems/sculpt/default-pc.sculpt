# configuration decisions
drivers: pc
system:  pc
gpu:     intel
manager: use_ram_fs
ram_fs:  depot

# supplemental depot content added to the system image
import: pkg/sculpt_drivers-pc
import: pkg/black_hole
import: pkg/top_view pkg/top_view_config pkg/top_view_storage

# selection of launcher-menu entries
launcher: vm_fs shared_fs download_debug_info black_hole trace_logger
launcher: audio mixer system_clock acpi_support recall_fs
launcher: top_view_config msr_gui lock-screen
launcher: firefox
# launcher: vm_mail vm_mail_fs
# launcher: vm_tc vm_tc_fs

# selection of accepted depot-package providers
depot: genodelabs cnuke alex-ab mstein nfeske cproc chelmuth jschlatow
depot: ssumpf skalk atopia

# preconfigured example scenarios
#presets: empty nano3d window_manager falkon_web_browser goa_testbed
presets: window_manager

build: lib/ld kernel core driver/platform driver/acpi app/sculpt_manager app/pci_decode app/depot_deploy
build: driver/gpu/intel driver/framebuffer/intel/pc driver/framebuffer/boot
